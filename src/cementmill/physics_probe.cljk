(ns cementmill.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  ASTM C109 / EN 196-1 cement-cube compressive-strength press simulation
  (`cementmill.robotics/simulate-press`) over a fixed sweep and print ONE
  EDN map of the physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2394/SOUL.md)
  reads every tick. Every number is derived from a time-stepped
  trajectory, never typed in. Output schema `itonami.physical-ai.probe.v1`
  (see cloud-itonami-isic-2013's probe for the shared contract).

  `:count` is an evidence floor: the bot treats 0 as \"could not
  measure\", never as \"nothing out of tolerance\". Exit 0 when every run
  produced numbers, 2 when any run did not."
  (:require [cementmill.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def band-42-5
  "The demo batches' own recorded 28-day acceptance band (MPa) for the
  42.5 strength class (`cementmill.store` batch-1/2/3/5)."
  {:strength-28d-min 42.5 :strength-28d-max 62.5})

(def sweep
  "Press configurations swept each tick: the store batches' own platen
  masses (7.0 / 12.0 / 14.0 / 16.5 kg) at the nominal 50 mm cube, plus
  the 12 kg fixture on a 40 mm and a 70.7 mm cube so a change in the
  geometry coupling shows up."
  [{:press-platen-mass-kg 7.0}
   {:press-platen-mass-kg 12.0}
   {:press-platen-mass-kg 14.0}
   {:press-platen-mass-kg 16.5}
   {:press-platen-mass-kg 12.0 :specimen-side-mm 40.0}
   {:press-platen-mass-kg 12.0 :specimen-side-mm 70.7}])

(defn- run-one [input]
  (let [t (select-keys (robotics/press-telemetry-for input)
                       [:sim-peak-compressive-force-n :sim-peak-compressive-stress-mpa
                        :sim-peak-crush-distance-m :ticks :dt :closing-velocity-mps
                        :specimen-half-extents-m])]
    {:input input
     :quantities (assoc t :peak-decel-mps2
                        (/ (:sim-peak-compressive-force-n t) (:press-platen-mass-kg input)))
     :out-of-tolerance? (boolean (robotics/strength-tolerance-out-of-range? (merge band-42-5 t)))}))

(defn- stress-at [mass-kg]
  (:sim-peak-compressive-stress-mpa (robotics/press-telemetry-for {:press-platen-mass-kg mass-kg})))

(defn- bisect
  "Boundary of monotone predicate `ok?` between `lo` (not ok) and `hi`
  (ok). nil when the bracket does not straddle."
  [ok? lo hi iters]
  (when (and (not (ok? lo)) (ok? hi))
    (loop [lo lo hi hi i 0]
      (if (>= i iters)
        hi
        (let [mid (/ (+ lo hi) 2.0)]
          (if (ok? mid) (recur lo mid (inc i)) (recur mid hi (inc i))))))))

(defn platen-mass-at-stress-kg
  "Smallest platen mass whose simulated peak stress reaches
  `stress-mpa`, by bisection over the REAL simulation (stress is
  monotone in platen mass -- pinned by the probe test). nil when the
  bracket does not straddle."
  ([stress-mpa] (platen-mass-at-stress-kg stress-mpa 0.01 100.0 40))
  ([stress-mpa lo hi iters]
   (bisect #(>= (stress-at %) stress-mpa) lo hi iters)))

(defn probe []
  (let [runs (mapv run-one sweep)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-peak-compressive-stress-mpa])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2394"
     :procedure "ASTM C109 / EN 196-1 cement mortar-cube 28-day compressive-strength press test (robot quality-lab cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:band-mpa band-42-5
               :min-platen-mass-kg-in-band (platen-mass-at-stress-kg (:strength-28d-min band-42-5))
               :max-platen-mass-kg-in-band (platen-mass-at-stress-kg (:strength-28d-max band-42-5))}
     :count (count (filter numeric? runs))
     :expected (count sweep)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
